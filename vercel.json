{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "yarn install --ignore-engines",
  "buildCommand": "yarn --ignore-engines --cwd packages/website build",
  "outputDirectory": "packages/website/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
